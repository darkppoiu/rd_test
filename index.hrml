<div id="offerModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Exclusive Offers</h2>
      <button class="close-btn" id="closeOffers">&times;</button>
    </div>
    <div id="offerList" class="offer-list">
      <div class="loader">Loading amazing deals...</div>
    </div>
  </div>
</div>

<style>
  :root {
    --primary: #2563eb;
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --bg-white: #ffffff;
    --radius: 16px;
  }

  /* Overlay with blur */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    display: none; /* Hidden by default */
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* Modal Container */
  .modal-content {
    background: var(--bg-white);
    width: 90%;
    max-width: 450px;
    border-radius: var(--radius);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    transform: translateY(20px);
    transition: transform 0.3s ease;
    overflow: hidden;
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0);
  }

  /* Header */
  .modal-header {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #f3f4f6;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-dark);
    font-family: sans-serif;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: var(--text-light);
  }

  /* Offer Items */
  .offer-list {
    padding: 15px;
    max-height: 400px;
    overflow-y: auto;
  }

  .offer-card {
    display: block;
    text-decoration: none;
    padding: 16px;
    margin-bottom: 12px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .offer-card:hover {
    background: #fff;
    border-color: var(--primary);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transform: scale(1.02);
  }

  .offer-anchor {
    display: block;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 4px;
  }

  .offer-conversion {
    font-size: 0.85rem;
    color: var(--text-light);
  }

  /* Trigger Button Styling */
  .trigger-btn {
    padding: 12px 24px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }
</style>

<script>
  const modal = document.getElementById('offerModal');
  const offerList = document.getElementById('offerList');
  const openBtn = document.getElementById('openOffers');
  const closeBtn = document.getElementById('closeOffers');

  const API_URL = "https://d2xohqmdyl2cj3.cloudfront.net/public/offers/feed.php?user_id=584180&api_key=ad55fcf79b3953d539938be8015c3900&s1=&s2=";

  async function fetchOffers() {
    try {
      const response = await fetch(API_URL);
      if (!response.ok) throw new Error('API Error');
      const data = await response.json();
      renderOffers(data.slice(0, 5));
    } catch (err) {
      offerList.innerHTML = '<p style="text-align:center">Failed to load offers.</p>';
    }
  }

  function renderOffers(offers) {
    offerList.innerHTML = offers.map(offer => `
      <a href="${offer.url}" target="_blank" class="offer-card">
        <span class="offer-anchor">${offer.anchor}</span>
        <span class="offer-conversion">${offer.conversion}</span>
      </a>
    `).join('');
  }

  // Open Modal Logic
  function myFunc(){

    modal.classList.add('active');
    fetchOffers(); // Fetch only when opened to save resources
 
	}
  openBtn.addEventListener('click', myFunc())

  // Close Modal Logic
  closeBtn.addEventListener('click', () => {
    modal.classList.remove('active');
  });

  // Close on outside click
  window.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.remove('active');
  });
	myFunc();
</script>



</body></html>
